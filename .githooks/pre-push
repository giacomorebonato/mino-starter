#!/usr/bin/env bash
# Full pre-merge gate at push time: lint + format check + typecheck + knip + unit tests.
# E2E (test:e2e) stays manual — run `bun run check:full` before claiming
# UI/auth work is done.
set -euo pipefail
cd "$(dirname "$0")/.."

printf '\033[1m→ pre-push: full check\033[0m\n'
bun run check
printf '\033[32m✓ pre-push green\033[0m\n'
