{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!.pi-subagents",
			"!.superpowers",
			"!dist",
			"!test-results",
			"!node_modules"
		]
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"trailingCommas": "all",
			"quoteStyle": "single"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
