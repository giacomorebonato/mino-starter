{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["bun-types"],
		"paths": {
			"@backend/*": ["./backend/*"],
			"@frontend/*": ["./frontend/*"],
			"@shared/*": ["./shared/*"]
		}
	},
	"include": ["frontend", "backend", "shared", "e2e"]
}
